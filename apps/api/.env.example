# --- Server ---
PORT=8787
HOST=0.0.0.0
# Comma-separated list of allowed browser origins ("*" allows any; fine for local dev)
CORS_ORIGINS=*
# Where the website lives (used to build invite links)
PUBLIC_WEB_URL=http://localhost:5173

# --- Database ---
# Local: SQLite file next to the schema. Production: a PostgreSQL URL (see docs/deployment.md)
DATABASE_URL="file:./dev.db"

# --- AI ---
# openai | mock   (mock = built-in sample data for Goa/Manali/Jaipur, no key needed)
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
# Reasoning depth for gpt-5.x models: low (≈50s per plan) | medium | high (slower, more thorough)
OPENAI_REASONING_EFFORT=low

# --- Demo tools ---
# true = seed demo friends, allow switching people, "See a sample plan". Turn off in production.
DEMO_MODE=true

# --- Booking affiliate IDs (optional) ---
BOOKING_AFFILIATE_ID=
MAKEMYTRIP_AFFILIATE_ID=
