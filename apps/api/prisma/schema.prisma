// Tripzy database schema.
// Local dev uses SQLite. For production switch `provider` to "postgresql" and point DATABASE_URL at Postgres
// (see docs/deployment.md). JSON payloads are stored as strings so the schema works on both.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Trip {
  id               String   @id @default(cuid())
  name             String
  destinationQuery String? // null = "suggest one for us"
  origin           String
  windowStart      String // YYYY-MM-DD
  windowEnd        String
  days             Int
  groupSize        Int
  inviteCode       String   @unique
  locked           Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members  Member[]
  plans    Plan[]
  jobs     GenerationJob[]
  bookings Booking[]
}

model Member {
  id          String    @id @default(cuid())
  tripId      String
  name        String
  color       String
  isOrganizer Boolean   @default(false)
  isDemoSeed  Boolean   @default(false) // pre-filled demo friend: votes automatically
  token       String    @unique // secret; sent as "Authorization: Bearer <token>"
  prefs       String? // JSON Preferences, null until answered
  respondedAt DateTime?
  createdAt   DateTime  @default(now())

  trip     Trip      @relation(fields: [tripId], references: [id], onDelete: Cascade)
  votes    Vote[]
  swaps    Swap[]
  bookings Booking[]

  @@index([tripId])
}

model Plan {
  id          String   @id @default(cuid())
  tripId      String
  version     Int
  isCurrent   Boolean  @default(true)
  source      String // "ai" | "mock"
  document    String // JSON PlanDocument
  stayId       String
  transportId  String   @default("") // legacy single-origin choice (plans made before per-city travel)
  transportIds String   @default("{}") // JSON { [origin]: optionId }
  changes      String   @default("{}") // JSON { stay?: ChangeInfo, travel: { [origin]: ChangeInfo } }
  stale        String? // JSON { reason, at } when stay/travel changed after the itinerary was planned
  createdAt    DateTime @default(now())

  trip  Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  votes Vote[]
  swaps Swap[]

  @@index([tripId, isCurrent])
}

model Vote {
  id       String @id @default(cuid())
  planId   String
  itemId   String
  memberId String
  value    String // "up" | "down"

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([planId, itemId, memberId])
}

model Swap {
  id       String @id @default(cuid())
  planId   String
  slotId   String // original activity id
  altId    String
  memberId String // who swapped it
  at       DateTime @default(now())

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([planId, slotId])
}

model GenerationJob {
  id        String   @id @default(cuid())
  tripId    String
  kind      String   @default("generate") // generate | adjust
  status    String // queued | running | done | failed
  stage     String
  error     String?
  planId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
}

/// Something the group has actually booked. Belongs to the trip (not a plan version) so it survives regeneration.
model Booking {
  id          String   @id @default(cuid())
  tripId      String
  kind        String // "stay" | "travel"
  origin      String   @default("") // travel: starting city; "" for the stay
  optionId    String? // the suggested option that was booked, if any
  snapshot    String // JSON Stay or TransportOption as booked (priceSource "booked")
  reference   String?
  link        String?
  bookedById  String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  trip     Trip   @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookedBy Member @relation(fields: [bookedById], references: [id], onDelete: Cascade)

  @@unique([tripId, kind, origin])
}
